<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for AdZero.

    POLICY:
    - All external HTTPS traffic uses system trust anchors (default).
    - Cleartext (HTTP) is ONLY permitted for 127.0.0.1 and ::1 (localhost) which
      the local VPN/DNS filter service needs to communicate with itself.
    - All other cleartext traffic is blocked — prevents accidental cookie leakage
      over unencrypted connections.
-->
<network-security-config>
    <!-- Global default: HTTPS only, no cleartext to the internet -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Localhost exception for the local VPN / DNS filter loopback -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
